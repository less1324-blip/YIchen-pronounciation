            `).join('')}
          </div>
        </div>
      `).join('');
    }

    function toggleIpaChartModal() {
      const modal = document.getElementById('ipaModal');
      if (modal.classList.contains('hidden')) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      } else {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    // =========================================================================
    // 5. GitHub 詞庫同步與錄音功能
    // =========================================================================
    async function fetchGithubJson() {
      try {
        const res = await fetch(GITHUB_RAW_URL, { cache: "no-store" });
        if (!res.ok) return;
        const remoteData = await res.json();
        if (remoteData && remoteData.word && Array.isArray(remoteData.syllables)) {
          // 為了確保舊版 GitHub 檔案不覆蓋內建精準 IPA，僅在單字不存在時補充
          const key = remoteData.word.toLowerCase();
          if (!PRESET_DB[key]) PRESET_DB[key] = remoteData;
        } else if (typeof remoteData === 'object') {
          Object.keys(remoteData).forEach(k => {
            if (remoteData[k]?.word && !PRESET_DB[k.toLowerCase()]) {
              PRESET_DB[k.toLowerCase()] = remoteData[k];
            }
          });
        }
        renderPresetButtons();
      } catch (e) {}
    }

    function renderPresetButtons() {
      const container = document.getElementById('presetButtons');
      container.innerHTML = '';
      Object.keys(PRESET_DB).forEach(wordKey => {
        const btn = document.createElement('button');
        btn.className = 'px-2.5 py-1 bg-slate-700 hover:bg-slate-600 rounded text-cyan-300 transition cursor-pointer';
        btn.textContent = wordKey;
        btn.onclick = () => loadPreset(wordKey);
        container.appendChild(btn);
      });
    }

    function loadPreset(word) {
      const key = word.toLowerCase();
      if (!PRESET_DB[key]) return;
      isPlayingLadder = false;
      onlineAudioUrl = null;
      document.getElementById('wordInput').value = PRESET_DB[key].word;
      renderWordData(PRESET_DB[key]);
    }

    async function startRecording(durationMs = null) {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        alert('請在 GitHub Pages (https://) 網址下開啟網頁，瀏覽器才會允許麥克風錄音！');
        return;
      }
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        mediaRecorder = new MediaRecorder(stream);
        audioChunks = [];
        mediaRecorder.ondataavailable = e => audioChunks.push(e.data);
        mediaRecorder.onstop = () => {
          const blob = new Blob(audioChunks, { type: 'audio/webm' });
          recordedAudioUrl = URL.createObjectURL(blob);
          document.getElementById('compareBtn').disabled = false;
          document.getElementById('recordBtn').classList.remove('recording-pulse');
          document.getElementById('recordBtn').textContent = '🎤 重新錄音';
          document.getElementById('echoStatus').textContent = '✅ 錄音完成！請點擊橘色按鈕「連續播放對比」聽聽看自己的發音。';
          isRecording = false;
          stream.getTracks().forEach(t => t.stop());
        };
        mediaRecorder.start();
        isRecording = true;
        document.getElementById('recordBtn').classList.add('recording-pulse');
        document.getElementById('recordBtn').textContent = '⏹ 停止錄音';
        if (durationMs) {
          setTimeout(() => {
            if (mediaRecorder && mediaRecorder.state === 'recording') mediaRecorder.stop();
          }, durationMs);
        }
      } catch (err) {
        alert('無法開啟麥克風：' + err.message);
      }
    }

    function toggleManualRecord() {
      if (isRecording && mediaRecorder) {
        mediaRecorder.stop();
      } else {
        document.getElementById('echoStatus').textContent = '🔴 正在錄音中... 請唸出單字';
        startRecording();
      }
    }

    function startEchoLoop() {
      const status = document.getElementById('echoStatus');
      status.textContent = '👂 階段 1/3：請仔細聽標準發音...';
      speakText(currentData.word, 0.85, () => {
        status.textContent = '🧠 階段 2/3：請在心裡「默唸回音」2 秒鐘...';
        setTimeout(() => {
          status.textContent = '🗣️ 階段 3/3：請開口唸出來！（系統自動錄音 2.5 秒）';
          startRecording(2500);
        }, 2000);
      });
    }

    function playComparison() {
      if (!recordedAudioUrl) return;
      const status = document.getElementById('echoStatus');
      status.textContent = '🔊 正在播放：標準發音...';
      speakText(currentData.word, 0.85, () => {
        setTimeout(() => {
          status.textContent = '🎧 正在播放：您的錄音...';
          const myAudio = new Audio(recordedAudioUrl);
          myAudio.onended = () => { status.textContent = '✨ 比對完畢！'; };
          myAudio.play();
        }, 350);
      });
    }

    function copyJson() {
      navigator.clipboard.writeText(JSON.stringify(currentData, null, 2));
      alert('已複製當前單字的標準 IPA 結構 JSON！');
    }

    window.addEventListener('DOMContentLoaded', () => {
      initVoices();
      renderPresetButtons();
      renderWordData(currentData);
      renderIpaReferenceChart();
      fetchGithubJson();
    });
  </script>
</body>
</html>

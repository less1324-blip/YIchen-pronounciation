<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="author" content="懿城文教機構-林哲宇">
  <meta name="copyright" content="懿城文教機構-林哲宇">
  <title>IPA 國際音標階梯拼讀系統 | 懿城文教機構-林哲宇</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .step-btn { transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
    .step-btn:active { transform: scale(0.94); }
    .playing-glow {
      border-color: #22d3ee !important;
      background-color: rgba(6, 182, 212, 0.28) !important;
      transform: scale(1.04);
      box-shadow: 0 0 20px rgba(34, 211, 238, 0.5);
    }
    @keyframes pulse-ring {
      0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
      70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
      100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }
    .recording-pulse { animation: pulse-ring 1.5s infinite; }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen font-sans p-4 md:p-8 flex flex-col justify-between">

  <div class="max-w-4xl mx-auto w-full space-y-6">
    <!-- 頂部品牌與功能列 -->
    <header class="bg-slate-800/90 border border-slate-700 rounded-2xl p-6 shadow-lg flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-semibold mb-2">
          <span>🏫 懿城文教機構 · 數位教學研發</span>
          <span>|</span>
          <span>林哲宇 老師監製</span>
        </div>
        <h1 class="text-2xl font-bold bg-gradient-to-r from-cyan-400 to-indigo-400 bg-clip-text text-transparent">
          標準 IPA 國際音標「階梯拼讀」訓練系統
        </h1>
        <p class="text-slate-400 text-sm mt-1">CMU 權威語音庫精準轉換 · 子母連音 (fa ➔ fan) · 可下載標準 IPA 範例庫</p>
      </div>

      <div class="flex flex-col items-end gap-2 w-full md:w-auto">
        <div class="flex flex-wrap items-center gap-2">
          <button onclick="downloadIpaSchemaJson()" class="bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold px-3.5 py-2.5 rounded-xl transition shadow cursor-pointer flex items-center gap-1">
            📥 下載標準 IPA 範例檔 (.json)
          </button>
          <button onclick="toggleIpaChartModal()" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold px-3.5 py-2.5 rounded-xl transition shadow cursor-pointer">
            📖 44 國際音標總表
          </button>
          <button onclick="testAudioEngine()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold px-3.5 py-2.5 rounded-xl transition shadow cursor-pointer">
            🔔 測試聲音
          </button>
        </div>
        <div class="flex flex-wrap items-center justify-end gap-2 text-xs mt-1">
          <span id="githubSyncStatus" class="text-emerald-400">✅ CMU + IPA 精準音標引擎已就緒</span>
          <span class="text-slate-600">|</span>
          <a href="https://github.com/less1324-blip/YIchen-pronounciation/blob/900cfe5de5616e727538f2f108435bd0be2af777/phonetic_schema.json.json" 
             target="_blank" rel="noopener noreferrer"
             class="text-cyan-400 hover:underline">查看 GitHub 詞庫檔 ↗</a>
        </div>
      </div>
    </header>

    <!-- 單字搜尋列 -->
    <section class="bg-slate-800/90 border border-slate-700 rounded-2xl p-6 shadow-lg">
      <div class="flex flex-col sm:flex-row gap-3">
        <input id="wordInput" type="text" value="fantastic" placeholder="輸入任何英文單字 (例如: fantastic, phenomenon, education, environment)..." 
          onkeydown="if(event.key==='Enter') analyzeWord()"
          class="flex-1 bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-lg font-medium text-white focus:outline-none focus:border-cyan-400">
        <button onclick="analyzeWord()" id="analyzeBtn"
          class="bg-cyan-600 hover:bg-cyan-500 text-white font-semibold px-6 py-3 rounded-xl transition flex items-center justify-center gap-2 cursor-pointer shadow-lg">
          <span>🔍 精準拆解 IPA 與階梯拼音</span>
        </button>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-400">
        <span>標準 IPA 範例單字：</span>
        <div id="presetButtons" class="flex flex-wrap gap-2"></div>
      </div>
    </section>

    <!-- 單字總覽與階梯拼讀核心區 -->
    <section class="bg-slate-800/90 border border-slate-700 rounded-2xl p-6 shadow-lg space-y-6">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-slate-700 pb-5">
        <div>
          <div class="flex items-baseline gap-4 flex-wrap">
            <h2 id="displayWord" class="text-4xl font-extrabold text-white tracking-wide">fantastic</h2>
            <div class="flex items-center gap-2">
              <span class="text-xs bg-amber-500/20 text-amber-300 border border-amber-500/30 px-2 py-0.5 rounded">標準 IPA</span>
              <span id="displayIPA" class="text-2xl font-mono font-bold text-amber-400">/fænˈtæs.tɪk/</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-xs bg-slate-700 text-slate-300 px-2 py-0.5 rounded">KK</span>
              <span id="displayKK" class="text-lg font-mono text-slate-300">[fænˋtæstɪk]</span>
            </div>
          </div>
          <p class="mt-2.5 text-lg text-slate-200">
            <span id="displayPos" class="bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 px-2 py-0.5 rounded text-sm font-mono mr-2">adj.</span>
            <span id="displayMeaning">極好的、異想天開的、不可思議的</span>
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button onclick="playGuidedLadder()" id="ladderPlayBtn" class="bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-white px-5 py-3 rounded-xl font-bold transition flex items-center gap-2 cursor-pointer shadow-lg">
            ▶️ 一鍵帶讀整套拼音 (fa, fan ➔ fantastic)
          </button>
        </div>
      </div>

      <!-- 階梯式拼讀面板 -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-cyan-300">
            👇 步驟 1：標準 IPA 階梯拼讀（先唸「子音+母音」，再唸「完整音節」）
          </h3>
        </div>

        <div id="ladderRows" class="space-y-3"></div>

        <!-- 最終整字組合大按鈕 -->
        <div class="mt-5 pt-4 border-t border-slate-700/80">
          <div class="text-xs text-slate-400 mb-2 font-semibold">🎯 最終整字連讀（把所有音節連貫串起來）：</div>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <button id="finalWordCard" onclick="playWholeWordCard(0.9)"
              class="step-btn flex-1 bg-gradient-to-r from-indigo-950/90 via-slate-900 to-indigo-950/90 border-2 border-indigo-400/70 hover:border-cyan-400 rounded-2xl p-4 flex items-center justify-between cursor-pointer shadow-md">
              <div class="flex items-baseline gap-4 flex-wrap">
                <span id="finalWordText" class="text-3xl font-extrabold text-white tracking-wider">fantastic</span>
                <span id="finalWordBreakdown" class="text-sm font-mono text-cyan-300">(fan · tas · tic)</span>
                <span id="finalWordPhonetic" class="text-xl font-mono text-amber-400">/fænˈtæs.tɪk/</span>
              </div>
              <span class="px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-sm font-semibold">🔊 真人/標準整字發音</span>
            </button>
            <button onclick="playStepSound(currentData.word, currentData.word + ' ' + currentData.ipa_full, 'finalWordCard', 0.55)"
              class="step-btn bg-slate-700 hover:bg-slate-600 text-slate-200 px-5 py-4 rounded-2xl font-medium cursor-pointer flex items-center justify-center gap-2">
              🐢 慢速唸整字
            </button>
          </div>
        </div>
      </div>

      <!-- 當前發音部位提示列 -->
      <div class="bg-slate-900/95 border border-cyan-500/30 rounded-xl p-4 flex items-center gap-3">
        <div class="text-2xl">👄</div>
        <div>
          <div class="text-sm font-bold text-cyan-400" id="activeStepTitle">準備就緒！點擊上方任一拼音方塊，即可聽取精準發音並查看口腔提示</div>
          <p class="text-slate-300 text-xs mt-0.5" id="activeStepDesc">每個階梯皆標註精準 IPA 國際音標，幫助學生建立「看到字母組合 ➔ 對應正確音標」的直覺。</p>
        </div>
      </div>
    </section>

    <!-- 步驟 2：Echo 回音跟讀與錄音自我檢測 -->
    <section class="bg-slate-800/90 border border-slate-700 rounded-2xl p-6 shadow-lg">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-300 mb-4">
        👇 步驟 2：Echo 回音記憶訓練 ＆ 學生錄音比對
      </h3>
      <div class="flex flex-wrap items-center gap-4">
        <button onclick="startEchoLoop()" id="echoBtn" class="bg-emerald-600 hover:bg-emerald-500 text-white font-semibold px-5 py-3 rounded-xl transition flex items-center gap-2 cursor-pointer">
          🎧 啟動 Echo 帶讀錄音 (聽標準音 ➔ 默唸回音 ➔ 自動錄音)
        </button>
        <button onclick="toggleManualRecord()" id="recordBtn" class="bg-rose-600 hover:bg-rose-500 text-white font-semibold px-5 py-3 rounded-xl transition flex items-center gap-2 cursor-pointer">
          🎤 直接錄音練習
        </button>
        <button onclick="playComparison()" id="compareBtn" disabled class="bg-amber-600 disabled:bg-slate-700 disabled:text-slate-500 hover:bg-amber-500 text-white font-semibold px-5 py-3 rounded-xl transition flex items-center gap-2 cursor-pointer">
          🔄 連續播放對比 (標準音 ➔ 我的發音)
        </button>
      </div>
      <div id="echoStatus" class="mt-4 text-sm font-medium text-cyan-300 min-h-[1.5rem]"></div>
    </section>

    <!-- 步驟 3：檢視與下載底層 JSON 資料結構 -->
    <section class="bg-slate-800/90 border border-slate-700 rounded-2xl p-6 shadow-lg">
      <div class="flex flex-wrap justify-between items-center gap-2 mb-3">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-400">當前單字 IPA 結構資料 (可複製或下載整個範例庫上傳至 GitHub)</h3>
        <div class="flex gap-2">
          <button onclick="copyJson()" class="text-xs bg-slate-700 hover:bg-slate-600 text-slate-200 px-3 py-1.5 rounded-lg transition cursor-pointer">📋 複製此單字 JSON</button>
          <button onclick="downloadIpaSchemaJson()" class="text-xs bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 px-3 py-1.5 rounded-lg transition cursor-pointer">📥 下載完整 phonetic_schema.json.json</button>
        </div>
      </div>
      <pre id="jsonViewer" class="bg-slate-950 text-emerald-400 p-4 rounded-xl text-xs font-mono overflow-x-auto max-h-60"></pre>
    </section>
  </div>

  <!-- 44 國際音標 (IPA) 互動點讀總表 Modal -->
  <div id="ipaModal" class="fixed inset-0 bg-black/75 z-50 hidden items-center justify-center p-4">
    <div class="bg-slate-800 border border-slate-600 rounded-2xl max-w-4xl w-full max-h-[85vh] flex flex-col shadow-2xl">
      <div class="p-5 border-b border-slate-700 flex justify-between items-center">
        <div>
          <h3 class="text-xl font-bold text-white">📖 標準 44 國際音標 (IPA) 互動點讀與範例總表</h3>
          <p class="text-xs text-slate-400 mt-1">點擊任一國際音標即可聽取標準發音與代表單字（懿城文教機構 · 林哲宇老師整理）</p>
        </div>
        <button onclick="toggleIpaChartModal()" class="text-slate-400 hover:text-white text-2xl font-bold px-2">&times;</button>
      </div>
      <div id="ipaChartContent" class="p-5 overflow-y-auto space-y-6"></div>
    </div>
  </div>

  <!-- 頁尾版權宣告 -->
  <footer class="max-w-4xl mx-auto w-full mt-10 pt-6 border-t border-slate-800 text-center text-xs text-slate-400 space-y-1">
    <p class="font-semibold text-slate-300 text-sm">版權所有 © 懿城文教機構 - 林哲宇 All Rights Reserved.</p>
    <p class="text-slate-500">
      GitHub 詞庫連結：
      <a href="https://github.com/less1324-blip/YIchen-pronounciation/blob/900cfe5de5616e727538f2f108435bd0be2af777/phonetic_schema.json.json" 
         target="_blank" rel="noopener noreferrer" class="text-cyan-400 hover:underline">
        less1324-blip/YIchen-pronounciation/phonetic_schema.json.json
      </a>
    </p>
  </footer>

  <script>
    // =========================================================================
    // 版權所有：懿城文教機構 - 林哲宇
    // GitHub 原始連結與自動 Raw 轉換
    // =========================================================================
    const GITHUB_BLOB_URL = "https://github.com/less1324-blip/YIchen-pronounciation/blob/900cfe5de5616e727538f2f108435bd0be2af777/phonetic_schema.json.json";
    const GITHUB_RAW_URL = GITHUB_BLOB_URL
      .replace("https://github.com/", "https://raw.githubusercontent.com/")
      .replace("/blob/", "/");

    // 美國 CMU 語音學權威詞典音素 (ARPAbet) 轉 標準國際音標 (IPA) 與 KK 音標對照表
    const ARPABET_TO_IPA = {
      "AA": { ipa: "ɑː", kk: "ɑ",   tts: "ah",   isVowel: true,  hint: "大口長母音 /ɑː/" },
      "AE": { ipa: "æ",  kk: "æ",   tts: "at",   isVowel: true,  hint: "蝴蝶音 /æ/（嘴角拉開、下巴壓低）" },
      "AH": { ipa: "ʌ",  kk: "ʌ",   tts: "up",   isVowel: true,  hint: "央母音 /ʌ/（輕音節為弱化音 /ə/）" },
      "AO": { ipa: "ɔː", kk: "ɔ",   tts: "aw",   isVowel: true,  hint: "圓唇後母音 /ɔː/" },
      "AW": { ipa: "aʊ", kk: "aʊ",  tts: "ow",   isVowel: true,  hint: "雙母音 /aʊ/（如 now）" },
      "AY": { ipa: "aɪ", kk: "aɪ",  tts: "eye",  isVowel: true,  hint: "雙母音 /aɪ/（如 time）" },
      "EH": { ipa: "ɛ",  kk: "ɛ",   tts: "eh",   isVowel: true,  hint: "小口短母音 /ɛ/（如 bed）" },
      "ER": { ipa: "ɝ",  kk: "ɝ",   tts: "er",   isVowel: true,  hint: "美式捲舌母音 /ɝ/（輕讀為 /ɚ/）" },
      "EY": { ipa: "eɪ", kk: "e",   tts: "ay",   isVowel: true,  hint: "雙母音 /eɪ/（如 day）" },
      "IH": { ipa: "ɪ",  kk: "ɪ",   tts: "ih",   isVowel: true,  hint: "放鬆短母音 /ɪ/（如 sit）" },
      "IY": { ipa: "iː", kk: "i",   tts: "ee",   isVowel: true,  hint: "微笑長母音 /iː/（如 see）" },
      "OW": { ipa: "oʊ", kk: "o",   tts: "oh",   isVowel: true,  hint: "圓唇雙母音 /oʊ/（如 go）" },
      "OY": { ipa: "ɔɪ", kk: "ɔɪ",  tts: "oy",   isVowel: true,  hint: "雙母音 /ɔɪ/（如 boy）" },
      "UH": { ipa: "ʊ",  kk: "ʊ",   tts: "book", isVowel: true,  hint: "放鬆圓唇短母音 /ʊ/（如 book）" },
      "UW": { ipa: "uː", kk: "u",   tts: "oo",   isVowel: true,  hint: "緊張圓唇長母音 /uː/（如 food）" },
      "B":  { ipa: "b",  kk: "b",   tts: "buh",  isVowel: false, hint: "有聲雙唇塞音 /b/" },
      "CH": { ipa: "tʃ", kk: "tʃ",  tts: "chuh", isVowel: false, hint: "無聲破擦音 /tʃ/" },
      "D":  { ipa: "d",  kk: "d",   tts: "duh",  isVowel: false, hint: "有聲齒齦塞音 /d/" },
      "DH": { ipa: "ð",  kk: "ð",   tts: "the",  isVowel: false, hint: "有聲咬舌音 /ð/（如 this）" },
      "F":  { ipa: "f",  kk: "f",   tts: "fuh",  isVowel: false, hint: "無聲唇齒音 /f/" },
      "G":  { ipa: "ɡ",  kk: "g",   tts: "guh",  isVowel: false, hint: "有聲舌根塞音 /ɡ/" },
      "HH": { ipa: "h",  kk: "h",   tts: "huh",  isVowel: false, hint: "無聲聲門音 /h/" },
      "JH": { ipa: "dʒ", kk: "dʒ",  tts: "juh",  isVowel: false, hint: "有聲破擦音 /dʒ/" },
      "K":  { ipa: "k",  kk: "k",   tts: "kuh",  isVowel: false, hint: "無聲舌根塞音 /k/" },
      "L":  { ipa: "l",  kk: "l",   tts: "luh",  isVowel: false, hint: "舌側音 /l/" },
      "M":  { ipa: "m",  kk: "m",   tts: "muh",  isVowel: false, hint: "雙唇鼻音 /m/" },
      "N":  { ipa: "n",  kk: "n",   tts: "nuh",  isVowel: false, hint: "齒齦鼻音 /n/" },
      "NG": { ipa: "ŋ",  kk: "ŋ",   tts: "ing",  isVowel: false, hint: "舌根鼻音 /ŋ/" },
      "P":  { ipa: "p",  kk: "p",   tts: "puh",  isVowel: false, hint: "無聲雙唇塞音 /p/" },
      "R":  { ipa: "r",  kk: "r",   tts: "ruh",  isVowel: false, hint: "美式捲舌音 /r/" },
      "S":  { ipa: "s",  kk: "s",   tts: "suh",  isVowel: false, hint: "無聲齒齦摩擦音 /s/" },
      "SH": { ipa: "ʃ",  kk: "ʃ",   tts: "shuh", isVowel: false, hint: "無聲捲舌摩擦音 /ʃ/" },
      "T":  { ipa: "t",  kk: "t",   tts: "tuh",  isVowel: false, hint: "無聲齒齦塞音 /t/" },
      "TH": { ipa: "θ",  kk: "θ",   tts: "thuh", isVowel: false, hint: "無聲咬舌音 /θ/（如 think）" },
      "V":  { ipa: "v",  kk: "v",   tts: "vuh",  isVowel: false, hint: "有聲唇齒音 /v/" },
      "W":  { ipa: "w",  kk: "w",   tts: "wuh",  isVowel: false, hint: "雙唇半母音 /w/" },
      "Y":  { ipa: "j",  kk: "j",   tts: "yuh",  isVowel: false, hint: "硬顎半母音 /j/（如 yes）" },
      "Z":  { ipa: "z",  kk: "z",   tts: "zuh",  isVowel: false, hint: "有聲齒齦摩擦音 /z/" },
      "ZH": { ipa: "ʒ",  kk: "ʒ",   tts: "zhuh", isVowel: false, hint: "有聲摩擦音 /ʒ/（如 vision）" }
    };

    // 標準 IPA 國際音標階梯拼讀範例庫（供預設展示與一鍵下載 .json）
    const PRESET_DB = {
      fantastic: {
        word: "fantastic",
        pos: "adj.",
        meaning: "極好的、異想天開的、不可思議的",
        ipa_full: "/fænˈtæs.tɪk/",
        kk_full: "[fænˋtæstɪk]",
        syllables: [
          {
            letters: "fan",
            ipa: "fæn",
            is_stressed: false,
            steps: [
              { text: "fa", ipa: "/fæ/", tts: "faa", hint: "無聲唇齒音 /f/ + 蝴蝶音 /æ/ 連讀" },
              { text: "fan", ipa: "/fæn/", tts: "fan", hint: "接上齒齦鼻音 /n/ ➔ /fæn/" }
            ]
          },
          {
            letters: "tas",
            ipa: "ˈtæs",
            is_stressed: true,
            steps: [
              { text: "ta", ipa: "/ˈtæ/", tts: "taa", hint: "無聲塞音 /t/ + 重讀蝴蝶音 /æ/ 連讀" },

    let currentData = PRESET_DB.fantastic;
    let selectedVoice = null;
    let onlineAudioUrl = null;
    let isPlayingLadder = false;
    let mediaRecorder = null;
    let audioChunks = [];
    let recordedAudioUrl = null;
    let isRecording = false;

    // =========================================================================
    // 1. 語音合成與真人音檔雙軌引擎
    // =========================================================================
    function initVoices() {
      if (!('speechSynthesis' in window)) return;
      const voices = window.speechSynthesis.getVoices();
      if (voices.length > 0) {
        selectedVoice = voices.find(v => v.lang === 'en-US' && (v.name.includes('Google') || v.name.includes('Natural') || v.name.includes('Samantha')))
                     || voices.find(v => v.lang.startsWith('en-US'))
                     || voices.find(v => v.lang.startsWith('en'));
      }
    }
    if ('speechSynthesis' in window) {
      window.speechSynthesis.onvoiceschanged = initVoices;
      initVoices();
    }

    function speakText(text, rate = 0.85, onEndCallback = null) {
      if ('speechSynthesis' in window) {
        try {
          window.speechSynthesis.cancel();
          if (window.speechSynthesis.paused) window.speechSynthesis.resume();
          const utter = new SpeechSynthesisUtterance(text);
          utter.lang = 'en-US';
          if (selectedVoice) utter.voice = selectedVoice;
          utter.rate = rate;
          utter.volume = 1.0;
          if (onEndCallback) {
            utter.onend = onEndCallback;
            utter.onerror = onEndCallback;
          }
          window.speechSynthesis.speak(utter);
          return;
        } catch (e) {}
      }
      const fallbackUrl = `https://translate.googleapis.com/translate_tts?client=gtx&ie=UTF-8&tl=en-US&q=${encodeURIComponent(text)}`;
      const audio = new Audio(fallbackUrl);
      audio.playbackRate = rate;
      if (onEndCallback) audio.onended = onEndCallback;
      audio.play().catch(() => { if (onEndCallback) onEndCallback(); });
    }

    function playStepSound(ttsText, displayLabel, elementId, rate = 0.8, hintText = '', onEnd = null) {
      document.querySelectorAll('.step-btn').forEach(el => el.classList.remove('playing-glow'));
      const targetEl = document.getElementById(elementId);
      if (targetEl) targetEl.classList.add('playing-glow');

      document.getElementById('activeStepTitle').innerHTML = `🔊 正在拼讀：<span class="text-amber-400 font-mono text-base">${displayLabel}</span>`;
      if (hintText) document.getElementById('activeStepDesc').textContent = hintText;

      speakText(ttsText, rate, () => {
        if (targetEl) targetEl.classList.remove('playing-glow');
        if (onEnd) onEnd();
      });
    }

    function playWholeWordCard(rate = 0.9) {
      const card = document.getElementById('finalWordCard');
      if (card) card.classList.add('playing-glow');
      if (rate >= 0.85 && onlineAudioUrl) {
        const audio = new Audio(onlineAudioUrl);
        audio.onended = () => card?.classList.remove('playing-glow');
        audio.play().catch(() => playStepSound(currentData.word, `${currentData.word} ${currentData.ipa_full}`, 'finalWordCard', rate));
      } else {
        playStepSound(currentData.word, `${currentData.word} ${currentData.ipa_full}`, 'finalWordCard', rate);
      }
    }

    // ▶️ 一鍵自動帶讀整套階梯拼音
    function playGuidedLadder() {
      if (isPlayingLadder) {
        window.speechSynthesis.cancel();
        isPlayingLadder = false;
        return;
      }
      isPlayingLadder = true;
      const queue = [];

      (currentData.syllables || []).forEach((syl, sIdx) => {
        const steps = syl.steps || [];
        steps.forEach((st, stIdx) => {
          queue.push({
            tts: st.tts || st.text,
            label: `${st.text} ${st.ipa || ''}`,
            elId: `step-${sIdx}-${stIdx}`,
            rate: 0.8,
            hint: st.hint || '子母連音階梯拼讀',
            pauseAfter: stIdx === steps.length - 1 ? 450 : 280
          });
        });
      });

      queue.push({
        tts: currentData.word,
        label: `${currentData.word} ${currentData.ipa_full || ''}`,
        elId: 'finalWordCard',
        rate: 0.9,
        hint: '🎉 整字連讀完成！',
        pauseAfter: 0
      });

      let idx = 0;
      function nextStep() {
        if (!isPlayingLadder || idx >= queue.length) {
          isPlayingLadder = false;
          return;
        }
        const item = queue[idx++];
        playStepSound(item.tts, item.label, item.elId, item.rate, item.hint, () => {
          setTimeout(nextStep, item.pauseAfter);
        });
      }
      nextStep();
    }

    function testAudioEngine() {
      initVoices();
      speakText("fa, fan. ta, tas. ti, tic. fantastic!", 0.85);
      document.getElementById('activeStepTitle').textContent = '✅ 聲音測試成功！';
      document.getElementById('activeStepDesc').textContent = '您現在可以點擊任何階梯按鈕，或輸入任何新單字取得精準 CMU/IPA 國際音標。';
    }

    // =========================================================================
    // 2. 語言學級精準音節與 IPA 演算法 (CMU ARPAbet -> 音節最大聲首切割 -> 階梯生成)
    // =========================================================================
    function convertArpabetToSyllables(word, arpabetStr) {
      const rawTokens = arpabetStr.trim().split(/\s+/);
      const phonemes = rawTokens.map(tok => {
        const match = tok.match(/^([A-Z]+)([012])?$/);
        const base = match ? match[1] : tok;
        const stress = match && match[2] ? parseInt(match[2], 10) : null;
        const info = ARPABET_TO_IPA[base] || { ipa: base.toLowerCase(), kk: base.toLowerCase(), tts: base.toLowerCase(), isVowel: false, hint: "" };

        // 精準處理美式母音弱化：AH0 -> ə, ER0 -> ɚ
        let ipaSym = info.ipa;
        let kkSym = info.kk;
        if (base === 'AH' && stress === 0) { ipaSym = 'ə'; kkSym = 'ə'; }
        if (base === 'ER' && stress === 0) { ipaSym = 'ɚ'; kkSym = 'ɚ'; }
        if (base === 'IY' && stress === 0) { ipaSym = 'i'; kkSym = 'ɪ'; }

        return {
          base,
          stress,
          isVowel: info.isVowel,
          ipa: ipaSym,
          kk: kkSym,
          tts: info.tts,
          hint: info.hint
        };
      });

      // 找出所有母音核心 (Nucleus) 的位置
      const vowelIndices = [];
      phonemes.forEach((p, idx) => { if (p.isVowel) vowelIndices.push(idx); });

      if (vowelIndices.length === 0) {
        return null;
      }

      // 依據語言學「最大聲首原則 (Maximal Onset Principle)」切分音節邊界
      const sylPhonemeGroups = [];
      let startIdx = 0;
      for (let v = 0; v < vowelIndices.length; v++) {
        const currV = vowelIndices[v];
        if (v === vowelIndices.length - 1) {
          sylPhonemeGroups.push(phonemes.slice(startIdx));
        } else {
          const nextV = vowelIndices[v + 1];
          const consonantsBetween = nextV - currV - 1;
          let splitPoint;
          if (consonantsBetween === 0) {
            splitPoint = currV + 1;
          } else if (consonantsBetween === 1) {
            // 單一子音歸給下一個音節當聲首 (V-CV)
            splitPoint = currV + 1;
          } else {
            // 兩個以上子音：前一個收尾 (Coda)，後一個歸下一音節聲首 (VC-CV)
            splitPoint = nextV - 1;
          }
          sylPhonemeGroups.push(phonemes.slice(startIdx, splitPoint));
          startIdx = splitPoint;
        }
      }

      // 將英文字母同步切分為對應數量的音節群
      const rawWordSyls = word.match(/[^aeiouy]*[aeiouy]+(?:[^aeiouy]*$|[^aeiouy](?=[^aeiouy]))?/gi) || [word];
      const wordSyls = [];
      if (rawWordSyls.length === sylPhonemeGroups.length) {
        wordSyls.push(...rawWordSyls);
      } else {
        // 若字母音節數與語音音節數不同，按比例分配字母
        const step = word.length / sylPhonemeGroups.length;
        for (let i = 0; i < sylPhonemeGroups.length; i++) {
          wordSyls.push(word.slice(Math.round(i * step), Math.round((i + 1) * step)) || word);
        }
      }

      // 為每個音節建立「Step 1: 子音+母音 (Onset+Nucleus) ➔ Step 2: 完整音節 (+Coda)」
      const syllables = sylPhonemeGroups.map((group, idx) => {
        const letters = wordSyls[idx] || word;
        const vPos = group.findIndex(p => p.isVowel);
        const vowelObj = group[vPos] || group[0];
        const isStressed = vowelObj.stress === 1 && sylPhonemeGroups.length > 1;
        const isSecondary = vowelObj.stress === 2 && sylPhonemeGroups.length > 1;
        const stressMarkIpa = isStressed ? 'ˈ' : (isSecondary ? 'ˌ' : '');
        const stressMarkKk = isStressed ? 'ˋ' : (isSecondary ? 'ˌ' : '');

        const onsetAndNucleus = group.slice(0, vPos + 1);
        const coda = group.slice(vPos + 1);

        const cvIpa = stressMarkIpa + onsetAndNucleus.map(p => p.ipa).join('');
        const fullIpa = stressMarkIpa + group.map(p => p.ipa).join('');
        const fullKk = stressMarkKk + group.map(p => p.kk).join('');

        // 取出對應的英文字母前段 (CV)
        const cvLetterMatch = letters.match(/^([^aeiouy]*[aeiouy]+)/i);
        const cvLetters = (coda.length > 0 && cvLetterMatch) ? cvLetterMatch[1] : letters;

        // 合成最準確的開音節 TTS 發音
        const onsetTts = onsetAndNucleus.slice(0, -1).map(p => p.ipa).join('');
        const cvTts = coda.length > 0 ? (onsetTts + vowelObj.tts) : letters;

        const steps = [];
        if (coda.length > 0) {
          steps.push({
            text: cvLetters,
            ipa: `/${cvIpa}/`,
            tts: cvTts,
            hint: `先拼讀子母音 /${cvIpa}/（${vowelObj.hint}）`
          });
          steps.push({
            text: letters,
            ipa: `/${fullIpa}/`,
            tts: letters,
            hint: `收尾音 /${coda.map(c => c.ipa).join('')}/ ➔ 完整音節 /${fullIpa}/`
          });
        } else {
          steps.push({
            text: letters,
            ipa: `/${fullIpa}/`,
            tts: letters,
            hint: `拼讀音節 /${fullIpa}/（${vowelObj.hint}）`
          });
        }

        return {
          letters,
          ipa: fullIpa,
          kk: fullKk,
          is_stressed: isStressed,
          steps
        };
      });

      const ipaFull = `/${syllables.map(s => s.ipa).join('.')}/`;
      const kkFull = `[${syllables.map(s => s.kk).join('')}]`;

      return { ipaFull, kkFull, syllables };
    }

    // =========================================================================
    // 3. 免金鑰查詢單字（串接 Datamuse CMU 語音庫 + Free Dictionary + 繁中翻譯）
    // =========================================================================
    async function analyzeWord() {
      const word = document.getElementById('wordInput').value.trim().toLowerCase();
      if (!word) return;

      if (PRESET_DB[word]) {
        loadPreset(word);
        playGuidedLadder();
        return;
      }

      const btn = document.getElementById('analyzeBtn');
      btn.disabled = true;
      btn.innerHTML = '<span>⏳ 查詢 CMU 與 IPA 權威庫中...</span>';

      let dictIpa = "";
      let pos = "word";
      let enDef = "";
      let zhMeaning = "";
      let arpabetStr = "";
      onlineAudioUrl = null;

      try {
        // 同步查詢：1. Datamuse (內建美國 CMU Pronouncing Dictionary 精準音素) 2. Free Dictionary 3. 繁中翻譯
        const [cmuRes, dictRes, transRes] = await Promise.allSettled([
          fetch(`https://api.datamuse.com/words?sp=${encodeURIComponent(word)}&md=pr&ipa=1&max=1`),
          fetch(`https://api.dictionaryapi.dev/api/v2/entries/en/${encodeURIComponent(word)}`),
          fetch(`https://api.mymemory.translated.net/get?q=${encodeURIComponent(word)}&langpair=en|zh-TW`)
        ]);

        if (cmuRes.status === 'fulfilled' && cmuRes.value.ok) {
          const cmuArr = await cmuRes.value.json();
          if (cmuArr[0] && cmuArr[0].word.toLowerCase() === word) {
            const tags = cmuArr[0].tags || [];
            const pronTag = tags.find(t => t.startsWith('pron:'));
            const ipaTag = tags.find(t => t.startsWith('ipa_pron:'));
            if (pronTag) arpabetStr = pronTag.replace('pron:', '').trim();
            if (ipaTag) dictIpa = `/${ipaTag.replace('ipa_pron:', '').trim()}/`;
          }
        }

        if (dictRes.status === 'fulfilled' && dictRes.value.ok) {
          const arr = await dictRes.value.json();
          const entry = arr[0];
          const foundIpa = entry.phonetic || (entry.phonetics?.find(p => p.text)?.text) || "";
          if (foundIpa) dictIpa = foundIpa;
          const audioObj = entry.phonetics?.find(p => p.audio && p.audio.length > 5);
          if (audioObj) onlineAudioUrl = audioObj.audio;
          if (entry.meanings && entry.meanings[0]) {
            pos = entry.meanings[0].partOfSpeech || pos;
            enDef = entry.meanings[0].definitions?.[0]?.definition || "";
          }
        }

        if (transRes.status === 'fulfilled' && transRes.value.ok) {
          const transData = await transRes.value.json();
          zhMeaning = transData?.responseData?.translatedText || "";
        }

        const cmuParsed = arpabetStr ? convertArpabetToSyllables(word, arpabetStr) : null;

        let newWordData;
        if (cmuParsed) {
          newWordData = {
            word,
            pos,
            meaning: zhMeaning ? (enDef ? `${zhMeaning} （${enDef}）` : zhMeaning) : (enDef || "已載入標準 IPA 拆解"),
            ipa_full: cmuParsed.ipaFull,
            kk_full: cmuParsed.kkFull,
            syllables: cmuParsed.syllables
          };
        } else {
          // 備援拆解
          newWordData = {
            word,
            pos,
            meaning: zhMeaning || enDef || "已載入音標拆解",
            ipa_full: dictIpa || `/${word}/`,
            kk_full: dictIpa ? `[${dictIpa.replace(/\//g, '')}]` : `[${word}]`,
            syllables: [{
              letters: word,
              ipa: (dictIpa || word).replace(/\//g, ''),
              is_stressed: true,
              steps: [{ text: word, ipa: dictIpa || `/${word}/`, tts: word, hint: "直接拼讀單字" }]
            }]
          };
        }

        PRESET_DB[word] = newWordData;
        renderPresetButtons();
        renderWordData(newWordData);
        playGuidedLadder();
      } catch (e) {
        console.warn('解析異常：', e);
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<span>🔍 精準拆解 IPA 與階梯拼音</span>';
      }
    }

    // =========================================================================
    // 4. 畫面渲染、下載 IPA 範例檔 (.json) 與 44 國際音標總表
    // =========================================================================
    function ensureStepsCompatible(syl) {
      if (Array.isArray(syl.steps) && syl.steps.length > 0) {
        return syl.steps.map(st => ({
          text: st.text,
          ipa: st.ipa || (st.phonetic ? `/${st.phonetic}/` : `/${st.text}/`),
          tts: st.tts || st.text,
          hint: st.hint || "子母連音階梯拼讀"
        }));
      }
      const letters = syl.letters || '';
      const ipaRaw = (syl.ipa || syl.phonetic || letters).replace(/\//g, '');
      const match = letters.match(/^([^aeiouy]*[aeiouy]+)(.+)$/i);
      if (match) {
        const cvPart = match[1];
        const codaPart = match[2];
        const phCut = Math.max(1, ipaRaw.length - codaPart.length);
        return [
          { text: cvPart, ipa: `/${ipaRaw.slice(0, phCut)}/`, tts: cvPart, hint: `先拼讀子母音「${cvPart}」` },
          { text: letters, ipa: `/${ipaRaw}/`, tts: letters, hint: `接上尾音「${codaPart}」➔ /${ipaRaw}/` }
        ];
      }
      return [{ text: letters, ipa: `/${ipaRaw}/`, tts: letters, hint: `拼讀音節 /${ipaRaw}/` }];
    }

    function renderWordData(data) {
      currentData = data;
      document.getElementById('displayWord').textContent = data.word;
      document.getElementById('displayIPA').textContent = data.ipa_full || '';
      document.getElementById('displayKK').textContent = data.kk_full || '';
      document.getElementById('displayPos').textContent = data.pos || 'word';
      document.getElementById('displayMeaning').textContent = data.meaning || '';

      document.getElementById('finalWordText').textContent = data.word;
      document.getElementById('finalWordBreakdown').textContent = `(${(data.syllables || []).map(s => s.letters).join(' · ')})`;
      document.getElementById('finalWordPhonetic').textContent = data.ipa_full || data.kk_full || '';

      const rowsContainer = document.getElementById('ladderRows');
      rowsContainer.innerHTML = '';

      (data.syllables || []).forEach((syl, sIdx) => {
        const steps = ensureStepsCompatible(syl);
        syl.steps = steps;

        const row = document.createElement('div');
        row.className = `rounded-2xl p-4 border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 transition ${
          syl.is_stressed 
            ? 'bg-indigo-950/50 border-indigo-400/80 shadow-md' 
            : 'bg-slate-900/70 border-slate-700/80'
        }`;

        const leftBadge = `
          <div class="flex items-center gap-2.5 min-w-[8rem]">
            <span class="w-7 h-7 rounded-full bg-slate-800 border border-slate-600 text-xs font-bold flex items-center justify-center text-cyan-400">
              ${sIdx + 1}
            </span>
            <div>
              <div class="text-xs font-semibold ${syl.is_stressed ? 'text-amber-300' : 'text-slate-400'}">
                ${syl.is_stressed ? '⭐ 主重音節' : `第 ${sIdx + 1} 音節`}
              </div>
              <div class="text-sm font-mono text-slate-300">${steps.map(st => st.text).join(', ')}</div>
            </div>
          </div>
        `;

        let stepsHtml = '<div class="flex flex-wrap items-center gap-3 flex-1">';
        steps.forEach((st, stIdx) => {
          const btnId = `step-${sIdx}-${stIdx}`;
          const isFinalSyllableStep = stIdx === steps.length - 1;
          const safeTts = (st.tts || st.text).replace(/'/g, "\\'");
          const safeHint = (st.hint || '').replace(/'/g, "\\'");

          stepsHtml += `
            <button id="${btnId}" type="button"
              onclick="playStepSound('${safeTts}', '${st.text} ${st.ipa}', '${btnId}', 0.8, '${safeHint}')"
              class="step-btn px-5 py-3 rounded-xl border text-left flex items-baseline gap-2.5 cursor-pointer ${
                isFinalSyllableStep
                  ? 'bg-cyan-500/20 border-cyan-400/60 hover:bg-cyan-500/30 text-white shadow'
                  : 'bg-slate-800/90 border-slate-600 hover:border-cyan-400/60 text-slate-200'
              }">
              <span class="text-2xl font-extrabold tracking-wide ${isFinalSyllableStep ? 'text-cyan-300' : 'text-white'}">${st.text}</span>
              <span class="text-base font-mono font-semibold text-amber-300">${st.ipa}</span>
              <span class="text-xs opacity-75 ml-1">🔊</span>
            </button>
          `;

          if (stIdx < steps.length - 1) {
            stepsHtml += `<span class="text-slate-500 font-bold text-lg select-none">➔</span>`;
          }
        });
        stepsHtml += '</div>';

        const rowPlayBtn = `
          <button type="button" onclick="playSingleRow(${sIdx})"
            class="text-xs bg-slate-800 hover:bg-slate-700 border border-slate-600 text-cyan-300 px-3 py-2 rounded-xl transition cursor-pointer whitespace-nowrap self-end sm:self-center">
            ▶️ 連讀 ${steps.map(s => s.text).join(', ')}
          </button>
        `;

        row.innerHTML = leftBadge + stepsHtml + rowPlayBtn;
        rowsContainer.appendChild(row);
      });

      document.getElementById('jsonViewer').textContent = JSON.stringify(data, null, 2);
    }

    function playSingleRow(sIdx) {
      isPlayingLadder = false;
      const syl = currentData.syllables[sIdx];
      const steps = syl.steps || [];
      let idx = 0;
      function next() {
        if (idx >= steps.length) return;
        const st = steps[idx];
        const btnId = `step-${sIdx}-${idx}`;
        idx++;
        playStepSound(st.tts || st.text, `${st.text} ${st.ipa}`, btnId, 0.8, st.hint, () => {
          setTimeout(next, 260);
        });
      }
      next();
    }

    // 📥 一鍵下載標準 IPA 國際音標範例 JSON 檔案 (可直接上傳至 GitHub)
    function downloadIpaSchemaJson() {
      const jsonString = JSON.stringify(PRESET_DB, null, 2);
      const blob = new Blob([jsonString], { type: "application/json;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "phonetic_schema.json.json";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    // 📖 渲染 44 國際音標 (IPA) 點讀總表
    function renderIpaReferenceChart() {
      const chartData = [
        {
          title: "一、 單元音（Monophthongs - 短母音與長母音）",
          items: [
            { ipa: "/iː/", kk: "[i]", word: "see", desc: "微笑長母音" },
            { ipa: "/ɪ/",  kk: "[ɪ]", word: "sit", desc: "放鬆短母音" },
            { ipa: "/eɪ/", kk: "[e]", word: "say", desc: "雙母音 A" },
            { ipa: "/ɛ/",  kk: "[ɛ]", word: "bed", desc: "小口短母音" },
            { ipa: "/æ/",  kk: "[æ]", word: "cat", desc: "蝴蝶音" },
            { ipa: "/ɑː/", kk: "[ɑ]", word: "father", desc: "大口長母音" },
            { ipa: "/ʌ/",  kk: "[ʌ]", word: "cup", desc: "重讀央母音" },
            { ipa: "/ə/",  kk: "[ə]", word: "sofa", desc: "弱化央母音" },
            { ipa: "/ɝ/",  kk: "[ɝ]", word: "bird", desc: "重讀捲舌母音" },
            { ipa: "/ɚ/",  kk: "[ɚ]", word: "teacher", desc: "輕讀捲舌母音" },
            { ipa: "/ɔː/", kk: "[ɔ]", word: "saw", desc: "圓唇後母音" },
            { ipa: "/oʊ/", kk: "[o]", word: "go", desc: "圓唇雙母音 O" },
            { ipa: "/ʊ/",  kk: "[ʊ]", word: "book", desc: "放鬆圓唇短音" },
            { ipa: "/uː/", kk: "[u]", word: "food", desc: "緊張圓唇長音" }
          ]
        },
        {
          title: "二、 雙母音（Diphthongs）",
          items: [
            { ipa: "/aɪ/", kk: "[aɪ]", word: "time", desc: "大口滑向 /ɪ/" },
            { ipa: "/aʊ/", kk: "[aʊ]", word: "now", desc: "大口滑向 /ʊ/" },
            { ipa: "/ɔɪ/", kk: "[ɔɪ]", word: "boy", desc: "圓唇滑向 /ɪ/" }
          ]
        },
        {
          title: "三、 子音（Consonants - 無聲與有聲對照）",
          items: [
            { ipa: "/p/",  kk: "[p]",  word: "pen", desc: "無聲雙唇塞音" },
            { ipa: "/b/",  kk: "[b]",  word: "ball", desc: "有聲雙唇塞音" },
            { ipa: "/t/",  kk: "[t]",  word: "tea", desc: "無聲齒齦塞音" },
            { ipa: "/d/",  kk: "[d]",  word: "dog", desc: "有聲齒齦塞音" },
            { ipa: "/k/",  kk: "[k]",  word: "cat", desc: "無聲舌根塞音" },
            { ipa: "/ɡ/",  kk: "[g]",  word: "go", desc: "有聲舌根塞音" },
            { ipa: "/f/",  kk: "[f]",  word: "fan", desc: "無聲唇齒音" },
            { ipa: "/v/",  kk: "[v]",  word: "van", desc: "有聲唇齒音" },
            { ipa: "/θ/",  kk: "[θ]",  word: "think", desc: "無聲咬舌音" },
            { ipa: "/ð/",  kk: "[ð]",  word: "this", desc: "有聲咬舌音" },
            { ipa: "/s/",  kk: "[s]",  word: "see", desc: "無聲齒齦摩擦音" },
            { ipa: "/z/",  kk: "[z]",  word: "zoo", desc: "有聲齒齦摩擦音" },
            { ipa: "/ʃ/",  kk: "[ʃ]",  word: "she", desc: "無聲捲舌摩擦音" },
            { ipa: "/ʒ/",  kk: "[ʒ]",  word: "vision", desc: "有聲捲舌摩擦音" },
            { ipa: "/tʃ/", kk: "[tʃ]", word: "chair", desc: "無聲破擦音" },
            { ipa: "/dʒ/", kk: "[dʒ]", word: "jump", desc: "有聲破擦音" },
            { ipa: "/m/",  kk: "[m]",  word: "man", desc: "雙唇鼻音" },
            { ipa: "/n/",  kk: "[n]",  word: "no", desc: "齒齦鼻音" },
            { ipa: "/ŋ/",  kk: "[ŋ]",  word: "sing", desc: "舌根鼻音" },
            { ipa: "/h/",  kk: "[h]",  word: "hat", desc: "無聲聲門音" },
            { ipa: "/l/",  kk: "[l]",  word: "leg", desc: "舌側音" },
            { ipa: "/r/",  kk: "[r]",  word: "red", desc: "捲舌音" },
            { ipa: "/w/",  kk: "[w]",  word: "wet", desc: "雙唇半母音" },
            { ipa: "/j/",  kk: "[j]",  word: "yes", desc: "硬顎半母音" }
          ]
        }
      ];

      const container = document.getElementById('ipaChartContent');
      container.innerHTML = chartData.map(sec => `
        <div>
          <h4 class="text-sm font-bold text-cyan-400 mb-3">${sec.title}</h4>
          <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 gap-2.5">
            ${sec.items.map(item => `
              <button onclick="speakText('${item.word}', 0.85)" 
                class="bg-slate-900 hover:bg-slate-700 border border-slate-700 hover:border-cyan-400 rounded-xl p-2.5 text-left transition cursor-pointer">
                <div class="flex justify-between items-baseline">
                  <span class="text-lg font-mono font-bold text-amber-400">${item.ipa}</span>
                  <span class="text-xs font-mono text-slate-400">KK ${item.kk}</span>
                </div>
                <div class="text-sm font-semibold text-white mt-1">🔊 ${item.word}</div>
